{
  "name": "bahmni-carbon-ui",
  "version": "2.0.0",
  "description": "Next generation ui components for OpenMRS and Bahmni built using the Carbon design system",
  "main": "dist/index.js",
  "author": "bahmni@thoughtworks.com",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.22.4",
    "@babel/preset-env": "^7.22.4",
    "@babel/preset-react": "^7.22.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^29.5.0",
    "babel-loader": "^9.1.2",
    "css-loader": "^6.8.1",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^13.2.2",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^2.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16",
    "style-loader": "^3.3.3",
    "webpack": "^5.86.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
    "@carbon/react": "^1.117.0",
    "moment": "^2.29.4",
    "prop-types": "^15.8.1",
    "react-intl": "^7.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "preinstall": "git config core.hooksPath .git-hooks",
    "prepack": "yarn build",
    "build": "webpack --mode production",
    "test": "jest",
    "bump:patch": "yarn version --no-git-tag-version --patch",
    "bump:minor": "yarn version --no-git-tag-version --minor",
    "bump:major": "yarn version --no-git-tag-version --major",
    "lint": "eslint src/**/*.{js,jsx}"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": {
      "import": "./dist/styles.css",
      "require": "./dist/styles.css"
    }
  },
  "lint-staged": {
    "*.(js|jsx)": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.!(js|jsx)": [
      "prettier --write --ignore-unknown"
    ]
  }
}
